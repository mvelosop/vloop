{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "brief-review/v1",
  "description": "A brief review session's report: the verdict on one brief and the findings behind it",
  "type": "object",
  "required": ["schema", "brief", "verdict", "findings"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "brief-review/v1" },
    "brief": { "type": "string" },
    "verdict": { "enum": ["PASS", "FIX", "ASK"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "section", "summary"],
        "properties": {
          "kind": { "enum": ["fact", "consistency", "rule", "runnability", "decision"] },
          "section": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string" },
          "fix": { "type": "string" }
        }
      }
    },
    "decisions": { "type": "array", "items": { "type": "string" } },
    "checked": { "type": "string" },
    "header": { "type": "string" }
  },
  "if": {
    "properties": { "verdict": { "enum": ["FIX", "ASK"] } },
    "required": ["verdict"]
  },
  "then": {
    "properties": { "findings": { "minItems": 1 } }
  }
}
