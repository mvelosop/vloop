#!/bin/sh
# Stub claude for the gate: logs argv, answers doctor's probes, and plays the
# plan, gate-review, work and review sessions. script.sh beside it, when
# present, is sourced first: it may set STUB_COST, STUB_DUR, STUB_SLEEP,
# STUB_DENIALS (a JSON array) and STUB_EXIT, and define stub_after, which runs
# after the session's own writes and before the result is printed.
dir=$(cd "$(dirname "$0")" && pwd -P)
echo "$*" >> "$dir/argv.log"
case "$1" in
  --version) echo "2.0.0 (Claude Code)"; exit 0;;
  plugin) echo '[]'; exit 0;;
esac
prompt=""; MODEL=""
while [ $# -gt 0 ]; do
  case "$1" in
    -p) prompt="$2"; shift 2;;
    --model) MODEL="$2"; shift 2;;
    *) shift;;
  esac
done
cmd="${prompt%% *}"; ARG="${prompt#* }"
case "$cmd" in
  /vloop:plan) PHASE=plan; TASK="";;
  /vloop:work) PHASE=work; TASK="$ARG";;
  /vloop:review) PHASE=review; TASK="$ARG";;
  /vloop:gate-review) PHASE=gate-review; TASK="";;
  *) echo "stub claude: unrecognised prompt: $prompt" >&2; exit 64;;
esac
STUB_EXIT=0 STUB_COST=0.1 STUB_DUR=1000 STUB_SLEEP=0 STUB_DENIALS='[]'
if [ -f "$dir/script.sh" ]; then . "$dir/script.sh"; fi
[ "$STUB_SLEEP" != 0 ] && sleep "$STUB_SLEEP"
mkdir -p .vloop/tmp
case "$PHASE" in
  plan) mkdir -p .vloop/state; cp "$dir/plan.json" .vloop/state/state.json;;
  gate-review) echo '{"schema":"gate-verdict/v1","verdict":"PASS","tasks":[],"notes":"none"}' > .vloop/tmp/gate-verdict.json;;
  work) touch "$TASK.out"
    printf '{"schema":"proposal/v1","task":"%s","outcome":"done","summary":"made %s","files":[],"verified":"ok","notes":"none"}\n' "$TASK" "$TASK" > .vloop/tmp/proposal.json;;
  review) printf '{"schema":"verdict/v1","task":"%s","verdict":"PASS","criteria":[],"findings":[],"notes":"none"}\n' "$TASK" > .vloop/tmp/verdict.json;;
esac
if type stub_after >/dev/null 2>&1; then stub_after; fi
jq -cn --arg m "$MODEL" --argjson c "$STUB_COST" --argjson d "$STUB_DUR" --argjson den "$STUB_DENIALS" \
  '{type:"result",subtype:"success",is_error:false,duration_ms:$d,num_turns:3,total_cost_usd:$c,session_id:"stub",permission_denials:$den,modelUsage:{($m):{costUSD:$c}}}'
exit "$STUB_EXIT"
