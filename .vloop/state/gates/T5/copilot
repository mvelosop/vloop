#!/bin/sh
# Gate T4's stub copilot: logs its argv, working directory and environment to
# $STUB_LOG, prints the JSON Lines file $STUB_OUT names, exits $STUB_RC.
if [ -n "${STUB_LOG:-}" ]; then
  { echo "=== stub"; for a in "$@"; do printf 'arg %s\n' "$a"; done
    printf 'cwd %s\n' "$(pwd -P)"; env | LC_ALL=C sort | sed 's/^/env /'; } >>"$STUB_LOG"
fi
[ -z "${STUB_OUT:-}" ] || cat "$STUB_OUT"
echo "stub stderr" >&2
exit "${STUB_RC:-0}"
