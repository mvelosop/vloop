      "Bash(vloop intervention add:*)",
      "Bash(vloop intervention set:*)",
      "Bash(vloop config set:*)",
      "Bash(.loop/run.sh:*)",
      "Edit(.git/**)",
      "Write(.git/**)",
      "Edit(.vloop/state/**)",
      "Write(.vloop/state/**)",
      "Edit(.vloop/config.toml)",
      "Write(.vloop/config.toml)",
      "Edit(.vloop/defects/**)",
      "Write(.vloop/defects/**)",
      "Edit(.vloop/interventions/**)",
      "Write(.vloop/interventions/**)",
      "Edit(.vloop/install.json)",
      "Write(.vloop/install.json)",
      "Read(~/.claude/**)",
      "Edit(~/.claude/**)",
      "Write(~/.claude/**)",
      "WebFetch",
      "WebSearch",
      "Bash(git -C:*)",
      "Bash(git -c:*)",
      "Bash(git --git-dir:*)",
      "Bash(git --work-tree:*)",
      "Bash(git --exec-path:*)",
      "Bash(git merge:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(git am:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git notes:*)",
      "Bash(git replace:*)",
      "Bash(git filter-branch:*)",
      "Bash(git worktree:*)",
      "Bash(git reflog:*)",
      "Bash(git gc:*)",
      "Bash(git config:*)",
      "Bash(git read-tree:*)",
      "Bash(git submodule:*)",
      "Bash(git prune:*)",
      "Bash(git repack:*)",
      "Bash(git hash-object:*)",
      "Bash(git fast-import:*)",
      "Bash(git format-patch:*)",
      "Bash(git diff*--output*)",
      "Bash(git log*--output*)",
      "Bash(git show*--output*)",
      "Bash(find*-delete*)",
      "Bash(find*-exec*)",
      "Bash(find*-ok*)",
      "Bash(find*-fprint*)",
      "Bash(find*-fls*)",
      "Bash(rm -r:*)",
      "Bash(rm -R:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -fR:*)",
      "Bash(rm --recursive:*)",
      "Bash(vloop -C:*)",
      "Bash(vloop --chdir:*)",
      "Bash(vloop brief new:*)"
