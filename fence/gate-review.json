      "Bash(git commit:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(git remote remove:*)",
      "Bash(git remote rm:*)",
      "Bash(git remote rename:*)",
      "Bash(git remote set-head:*)",
      "Bash(git remote set-branches:*)",
      "Bash(git remote prune:*)",
      "Bash(git remote update:*)",
      "Bash(git update-ref:*)",
      "Bash(git symbolic-ref:*)",
      "Bash(git tag:*)",
      "Bash(git stash:*)",
      "Bash(git rebase:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(pip install:*)",
      "Bash(claude:*)",
      "Bash(vloop run:*)",
      "Bash(vloop init:*)",
      "Bash(vloop upgrade:*)",
      "Bash(vloop brief close:*)",
      "Bash(vloop task verify:*)",
      "Bash(vloop task reset:*)",
      "Bash(vloop task note:*)",
      "Bash(vloop task drop:*)",
      "Bash(vloop task set:*)",
      "Bash(vloop defect add:*)",
