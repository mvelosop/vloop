{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "TodoWrite",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(jq:*)",
      "Bash(vloop config get:*)",
      "Bash(vloop status:*)",
      "Bash(vloop task list:*)",
      "Bash(vloop task show:*)",
      "Bash(vloop task validate:*)",
      "Bash(vloop task gate:*)",
      "Bash(vloop schema validate:*)",
      "Edit(.vloop/tmp/**)",
      "Write(.vloop/tmp/**)"
    ],
    "deny": [
