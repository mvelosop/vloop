{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "intervention/v1",
  "description": "A recorded operator intervention: the frontmatter of .vloop/interventions/I<stamp>-<slug>.md as JSON",
  "type": "object",
  "required": ["schema", "id", "brief", "phase", "kind", "automatable", "by", "occurred", "recorded"],
  "properties": {
    "schema": { "const": "intervention/v1" },
    "id": { "type": "string" },
    "brief": { "type": "string" },
    "phase": { "enum": ["setup", "design", "run", "halt", "verify", "close", "next"] },
    "kind": { "enum": ["direction", "decision", "context-supply", "halt", "verification-finding", "repair", "carry-forward", "ceremony"] },
    "automatable": { "enum": ["yes", "partly", "no"] },
    "by": { "enum": ["operator", "assistant", "both"] },
    "occurred": { "type": "string", "format": "date" },
    "recorded": { "type": "string", "format": "date-time" },
    "backfilled": { "type": "boolean" },
    "summary": { "type": "string" },
    "trigger": { "type": "string" },
    "done": { "type": "string" },
    "automation": { "type": "string" }
  }
}
